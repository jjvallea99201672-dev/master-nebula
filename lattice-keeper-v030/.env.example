# ---- required -------------------------------------------------------------
# One or more API keys (comma-separated), each >= 32 chars.
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
LATTICE_API_KEY=
# Used by docker-compose for Redis auth.
REDIS_PASSWORD=
# Encrypts private keys at rest (scrypt + AES-256-GCM). Strongly recommended.
LATTICE_KEY_PASSPHRASE=

# Optional device keys (comma-separated, >= 32 chars each). Device keys can ONLY
# call POST /telemetry and GET /policy; use one per ESP32 so a key pulled from a board's flash
# can't reach the other endpoints.
DEVICE_API_KEYS=

# ---- server -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8765
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_RETRIES=10
MAX_BODY_BYTES=65536
RATE_LIMIT_PER_MINUTE=60
RECORD_TTL_SECONDS=315360000
SHUTDOWN_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
KEYS_DIR=./keys

# ---- post-quantum -----------------------------------------------------------
# true  = refuse to start without liboqs (ML-DSA-65 / ML-KEM-768)
# false = run Ed25519-only; every response says pqc: "unavailable"
REQUIRE_PQC=true
# Where liboqs is installed (lib/liboqs.so). Set automatically in Docker.
# OQS_INSTALL_PATH=/opt/oqs

# ---- reference-value check (optional; leave blank to disable) ---------------
# A request to /rwa/tokenize must match every value set here. This is a
# configured consistency check, NOT an audit. Values below are the ones
# hardcoded in v0.28; change or blank them as needed.
REFERENCE_ANCHOR_HASH=fd0adf9005622e103f02115a50314d91f83dc705f1d685b16d45f52ad6b940b2
REFERENCE_CONTROL_VARIABLE=Canadian Wildlife Conservation Report 2026 (CRC-2026-001)
REFERENCE_REPORT_ID=CRC-2026-001
REFERENCE_VALUATION_CAD=3100000000.00
REFERENCE_VALUATION_TOLERANCE=0.01

# ---- operator-signed policy (v0.30) ---------------------------------------------
# Public key of the OFFLINE operator key (lattice-keeper operator-keygen --out DIR on
# the operator's own machine). Give the server only operator_pubkey.json, never the
# operator_*.key files. Without it, every PUT /policy is rejected.
# With REQUIRE_PQC=true the operator key must be hybrid (made with liboqs available).
OPERATOR_PUBKEY_FILE=
# ...or inline base64 instead of the file (not both):
# OPERATOR_ED25519_PUBKEY=
# OPERATOR_ML_DSA_65_PUBKEY=
# Allowed clock skew for a policy's effective_at (seconds).
POLICY_CLOCK_SKEW_SECONDS=300
# Used only by `policy-sign` / `operator-keygen` on the operator machine (or enter it at the prompt).
# OPERATOR_KEY_PASSPHRASE=

# ---- guardian heuristic -----------------------------------------------------
# GENESIS POLICY ONLY: read once to build policy v1 when Redis has no policy.
# After that, change the blocklist with a signed policy (PUT /policy).
# Comma-separated words/phrases, matched case-insensitively on whole words.
GUARDIAN_BLOCKLIST=bypass,jailbreak,ignore previous instructions,exploit,malware,ransomware

# ---- model / RAG --------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30
RAG_ENABLED=false
RAG_INDEX_DIR=
# Printed by `lattice-keeper rag-build`; the index is refused unless this matches.
RAG_INDEX_MANIFEST_SHA256=
RAG_EMBED_MODEL=nomic-embed-text

# ---- device telemetry -----------------------------------------------------------
# GENESIS POLICY ONLY: initial values.telemetry.beta_global (0.1-5.0). Unset = devices
# use their default. Since v0.30 change it with a signed policy; PUT /telemetry/beta_global
# returns 410.
TELEMETRY_BETA_GLOBAL=
# Samples kept per device in Redis.
TELEMETRY_HISTORY=1000
